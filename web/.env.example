# Copy to .env.local for local development. On Vercel, set these in Project Settings > Environment Variables.

# --- Chain ---
ARC_RPC_URL=https://rpc.testnet.arc.io
ARC_CHAIN_ID=5042002
CONTRACT_ADDRESS=0x...            # WardrobePassportV2 on Arc Testnet

# --- Wallets ---
# "circle" in production. "local" derives throwaway keys on the server (development and tests only).
WALLET_PROVIDER=circle
CIRCLE_API_KEY=                   # secret, never commit
CIRCLE_ENTITY_SECRET=             # secret, never commit
CIRCLE_WALLET_SET_ID=             # optional; created on first use if empty (then copy it here)
LOCAL_WALLET_SEED=dev-only-seed   # used only when WALLET_PROVIDER=local

# --- Database ---
# Postgres connection string (Supabase "Transaction pooler" URI). If empty, an in-memory Postgres is used (development only).
DATABASE_URL=
